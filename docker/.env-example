FLASK_CONTEXT=production
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_RECORD_QUERIES=False
PROD_DATABASE_URI='postgresql://usuario:password@host:puerto/nombre_base_de_datos'

# Hashids defaults (compartidos por los microservicios)
HASHIDS_SALT=cambia-esta-sal
HASHIDS_MIN_LENGTH=10
HASHIDS_ALPHABET=abcdefghijklmnopqrstuvwxyz1234567890

# Configuración Gestion
GESTION_DB_NAME=gestion
GESTION_DB_USER=gestion_user
GESTION_DB_PASSWORD=gestion_password
GESTION_FLASK_ENV=production
GESTION_SECRET_KEY=super-secret-key
GESTION_DEV_DATABASE_URI=postgresql+psycopg2://gestion_user:gestion_password@gestion-db:5432/gestion_dev
GESTION_TEST_DATABASE_URI=sqlite:///:memory:
GESTION_DATABASE_URI=postgresql+psycopg2://gestion_user:gestion_password@gestion-db:5432/gestion

# Configuración Alumno (Django)
ALUMNO_DB_NAME=sysacad
ALUMNO_DB_USER=sysacad
ALUMNO_DB_PASSWORD=sysacad_password
ALUMNO_SECRET_KEY=django-secret-key
ALUMNO_DEBUG=True
ALUMNO_ALLOWED_HOSTS=localhost,127.0.0.1,alumno

# Configuración Documentación
DOCUMENTACION_DB_NAME=documentacion
DOCUMENTACION_DB_USER=doc_user
DOCUMENTACION_DB_PASSWORD=doc_password
DOCUMENTACION_FLASK_CONTEXT=production
DOCUMENTACION_SECRET_KEY=documentacion-secret
DOCUMENTACION_DEV_DATABASE_URI=postgresql+psycopg2://doc_user:doc_password@documentacion-db:5432/documentacion
DOCUMENTACION_TEST_DATABASE_URI=postgresql+psycopg2://doc_user:doc_password@documentacion-db:5432/documentacion_test
DOCUMENTACION_PROD_DATABASE_URI=postgresql+psycopg2://doc_user:doc_password@documentacion-db:5432/documentacion
DOCUMENTACION_HASHIDS_SALT=documentacion-salt
DOCUMENTACION_HASHIDS_MIN_LENGTH=10
DOCUMENTACION_HASHIDS_ALPHABET=abcdefghijklmnopqrstuvwxyz1234567890
DOCUMENTACION_REDIS_PORT=6379
DOCUMENTACION_REDIS_DB=0
DOCUMENTACION_REDIS_PASSWORD=