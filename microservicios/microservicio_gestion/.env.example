FLASK_ENV=development

# Claves y base de datos
GESTION_SECRET_KEY=super-secret-key
GESTION_DEV_DATABASE_URI=sqlite:///gestion_dev.db
GESTION_TEST_DATABASE_URI=sqlite:///:memory:

# Redis / resiliencia
GESTION_REDIS_URL=redis://localhost:6379/0
GESTION_RATE_LIMIT=60 per minute

# Dependencias externas
DOCUMENTACION_BASE_URL=http://localhost:5001
DOCUMENTACION_TIMEOUT=3

